# 可选。所有配置都保存在 SQLite 配置库里，并通过 Web 控制台维护。
# 这个文件只用于“配置库第一次创建时”导入初始值（之后修改这里不会再生效）。
# run_web.sh / run_download.sh 会自动加载同目录的 .env；Windows 请直接在 Web 控制台里填写。

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rocp-data

MINIO_PG_HOST=127.0.0.1
MINIO_PG_PORT=5432
MINIO_PG_DATABASE=minio_event
MINIO_PG_USER=postgres
MINIO_PG_PASSWORD=

# 初始访问口令（至少 6 个字符）；监听非本机地址前必须设置
MINIO_WEB_TOKEN=
